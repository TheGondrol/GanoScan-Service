__pycache__/
*.pyc
.venv/
venv/
.env
.DS_Store
scans.db
uploads/*
!uploads/.gitkeep

# Model artifacts ARE committed (needed so `docker build` from a plain git
# clone has something to COPY — Render builds from the repo, not this
# machine). Only these 3 exact filenames are tracked; anything else dropped
# into models/ (e.g. a numbered notebook export like 05_best_model.pth)
# stays ignored.
models/*
!models/.gitkeep
!models/model_jit.pt
!models/best_model.pth
!models/model_info.json
