# Copy to .env and adjust. All optional — sane defaults are baked in.
# GANOSCAN_MODEL_DIR=./models
# GANOSCAN_PORT=5000
# GANOSCAN_HOST=0.0.0.0
# GANOSCAN_DB=scans.db
# GANOSCAN_UPLOADS=uploads
# GANOSCAN_GAMMA=0.8
# GANOSCAN_DEFAULT_BLOCK=Blok C
# GANOSCAN_ADMIN_TOKEN=              # set before deploying publicly; guards DELETE /scan(s)
# GANOSCAN_API_KEY=                  # set before deploying publicly; guards every endpoint except /health
#                                     # must match ApiClient.API_KEY in the Android app
